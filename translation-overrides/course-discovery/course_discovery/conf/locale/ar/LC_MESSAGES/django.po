#: apps/course_metadata/management/commands/publish_live_course_runs.py:23
#, python-brace-format
msgid "Publishing course run {key}"
msgstr "نشر عرض المقرر {key}"

#: apps/course_metadata/management/commands/publish_live_course_runs.py:34
