msgstr ""
"لا يتطابق الشريك {partner_key} وشريك المقرر {course_partner_key} عند محاولة "
"حفظ عنوان رابط الشارة {url_slug}"

#: apps/course_metadata/models.py:4270
#, python-brace-format
msgid ""
"Partner {partner_key} and course partner {course_partner_key} do not match "
